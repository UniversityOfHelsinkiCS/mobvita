{
  "name": "mobvita",
  "version": "1.0.0",
  "description": "Frontend for Revita",
  "main": "index.js",
  "scripts": {
    "dev": "docker compose -f docker-compose-local.yml up",
    "build": "vite build",
    "dev:build": "docker compose -f docker-compose-local.yml up --build",
    "prepare": "husky",
    "start:prod": "cross-env NODE_ENV=production node index.js",
    "start:dev": "cross-env NODE_ENV=development nodemon index.js",
    "start:ci": "cross-env ENVIRONMENT=staging node index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "design:screenshots": "cypress run --browser chrome --config-file cypress.design.config.js",
    "design:screenshots:teacher": "cypress run --browser chrome --config-file cypress.design.config.js --env mode=teacher",
    "design:screenshots:open": "cypress open --browser chrome --config-file cypress.design.config.js",
    "add-translation": "node addTranslation.js"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "author": "Olli-Pekka Turtio",
  "license": "ISC",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-date-pickers": "^9.16.0",
    "@sentry/react": "^11.9.0",
    "autoprefixer": "^10.6.2",
    "axios": "^1.21.0",
    "canvas-confetti": "^1.9.4",
    "chokidar": "^6.0.0",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.1",
    "express": "^5.3.0",
    "highcharts": "^13.1.1",
    "highcharts-react-official": "^3.2.3",
    "howler": "^2.2.4",
    "immer": "^11.2.9",
    "lemmatizer": "0.0.1",
    "multer": "^2.1.1",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-draggable": "^4.7.2",
    "react-intl": "^12.1.6",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.14.2",
    "react-simple-keyboard": "^3.8.290",
    "react-svg-pan-zoom": "^3.13.1",
    "react-timer-hook": "^4.0.9",
    "react-toastify": "^11.1.0",
    "react-virtualized": "^10.0.0",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "sass": "^1.106.1",
    "swagger-ui-express": "^5.0.1",
    "swiper": "^14.3.0",
    "winston": "^3.19.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@googleapis/sheets": "^18.1.1",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10",
    "sanitize-html": "^2.18.1",
    "vite": "^8.0.10",
    "wait-on": "^9.5.1"
  },
  "nodemonConfig": {
    "ignore": [
      "dist/**",
      "client/**",
      "server/**",
      "cypress/**",
      "node_modules/**",
      ".git/**"
    ]
  },
  "imports": {
    "#root/*": "./*.js",
    "#controllers/*": "./server/controllers/*.js",
    "#middleware/*": "./server/middleware/*.js",
    "#util/*": "./server/util/*.js"
  },
  "allowScripts": {
    "cypress": true,
    "@parcel/watcher": false,
    "fsevents": false,
    "@scarf/scarf": false
  }
}
